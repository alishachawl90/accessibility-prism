{
  "name": "accessibility-prism",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.js",
    "test:chrome": "npm run build && \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --user-data-dir=/tmp/accessibility-prism-chrome-profile --load-extension=\"$(pwd)/dist\" --auto-open-devtools-for-tabs --no-first-run --no-default-browser-check --window-size=1440,900"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@types/axe-core": "^2.0.2",
    "axe-core": "^4.11.1"
  }
}
